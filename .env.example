# MemoryGraph binds to loopback by default. Set explicit values only when needed.
MEMORYGRAPH_DATA_DIR=.memorygraph-data
MEMORYGRAPH_HOST=127.0.0.1
MEMORYGRAPH_PORT=4765

# Optional Neo4j projection. SQLite remains the durable source of truth.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional Graphiti enrichment sidecar.
GRAPHITI_URL=
GRAPHITI_API_KEY=

