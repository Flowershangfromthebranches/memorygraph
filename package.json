{
  "name": "memorygraph",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first shared project state, temporal memory graph, and pull-based handoff for coding agents.",
  "type": "module",
  "bin": {
    "memorygraph": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "tsx watch src/cli.ts serve --data-dir .memorygraph-dev --port 4765",
    "dev:web": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mcp": "tsx src/mcp/main.ts",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run typecheck && npm test && npm run build && npm run skill:validate",
    "verify:stdio": "node scripts/verify-stdio.mjs",
    "verify:opencode-adapter": "node scripts/verify-opencode-adapter.mjs",
    "skill:validate": "node scripts/validate-skill.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "d3-hierarchy": "^3.1.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.33.0",
    "neo4j-driver": "^6.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "^3.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
